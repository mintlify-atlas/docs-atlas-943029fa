  "publicApiSurface": [
    "GET /api/users — list and search users/crew members",
    "GET /api/users/:id — get a specific user profile",
    "POST /api/users — create a new user account",
    "PUT /api/users/:id — update user profile",
    "GET /api/listings — browse production listings and job opportunities",
    "POST /api/listings — create a new listing",
    "GET /api/locations — search filming locations",
    "POST /api/locations — list a new location",
    "GET /api/equipment — browse available equipment",
    "POST /api/equipment — list equipment for rent",
    "GET /api/opportunities — browse production opportunities",
    "POST /api/opportunities — post a new opportunity"
